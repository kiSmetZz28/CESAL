# The image carries the tracked repository only. Everything below is either fetched at
# run time (checkpoints, LLM weights), installed during the build (ExecuTorch), or local state.

# ── Git and editor state ─────────────────────────────────────────────────────
.git/
.claude/
.vscode/
.idea/

# ── Checkpoints — fetched by `run.py download` into a mounted volume ─────────
checkpoints/

# ── ExecuTorch — installed during the build by tools/setup_executorch.py ─────
cesal_inference_pipeline/executorch/
cesal_inference_pipeline/executorch.zip

# ── Run outputs — keep only the tracked thresholds and Table 7 reference ─────
outputs/*/*
!outputs/*/thresholds_cloud.yaml
!outputs/*/thresholds_edge.yaml
!outputs/hdfs/llm/table7_reference_metrics.csv

# ── Runtime artefacts ────────────────────────────────────────────────────────
logs/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
dashboard/cesal.db
dashboard/*.bak
**/*.mp4
data/OpenStack/raw/
