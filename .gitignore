# Editor / tool local config
.vscode/
.claude/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.env/
.conda/

# Jupyter
.ipynb_checkpoints/

# Build artifacts
*.egg-info/
dist/
build/
.eggs/

# Tests and test artifacts
tests/
.pytest_cache/
.coverage
htmlcov/

# Logs (auto-generated by setup_logging)
*.log
logs/

# Runtime outputs (checkpoints and outputs are deployment artifacts)
checkpoints/
outputs/*
# Exception: pre-computed thresholds are small and allow users to skip eval
!outputs/*/
outputs/*/*
!outputs/*/thresholds_cloud.yaml
!outputs/*/thresholds_edge.yaml
# Exception: paper Table 7 reference metrics for the LLM incident classifier
!outputs/*/llm/
outputs/*/llm/*
!outputs/*/llm/table7_reference_metrics.csv

# SQLite database (rebuilt at runtime, too large for GitHub)
*.db

# Large video files (>100 MB GitHub limit) — tools/deploy/deploy_hf.py uploads them to HF Space directly
*.mp4
*.mov

# ExecuTorch source + build tree (~1.4 GB, downloaded via tools/download_data.py)
cesal_inference_pipeline/executorch/
cesal_inference_pipeline/executorch.zip
